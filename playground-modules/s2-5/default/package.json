{
  "name": "nest-playground",
  "version": "0.0.1",
  "description": "NestJS playground project",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
